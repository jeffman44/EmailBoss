  "id_patterns": [
    {
      "key": "matter_no",
      "label": "Matter #",
      "regex": "\\b(?:Matter|File)\\s*#?\\s*:?\\s*(\\d{3,8}(?:-\\d{1,4})?)\\b",
      "unique_match": true
    },
    {
      "key": "case_no",
      "label": "Case #",
      "regex": "\\b(?:Case|Docket|Cause)\\s*(?:No\\.?|#)\\s*:?\\s*([A-Z0-9]{2,6}[-:/]?\\d{2,}[-A-Z0-9]*)\\b",
      "unique_match": true
    }
  ],
  "date_types": [
    {
      "id": "follow_up",
      "label": "Follow-up"
    },
    {
      "id": "deadline",
      "label": "Court date"
    },
    {
      "id": "sla",
      "label": "Reply by"
    }
  ],
  "teams": [],
  "business_hours": {
    "tz": "",
    "start": 8,
    "end": 17,
    "days": [
      0,
      1,
      2,
      3,
      4
    ]
  },
  "sla_hours": 4,
  "money": {
    "currency": "USD",
    "annual_goal": null
  },
  "triage": {
    "classifications": [
      "request",
      "client_reply",
      "approval",
      "vendor",
