  "prompt_profile": {
    "industry": "legal services",
    "role_noun": "attorney"
  },
  "customer_visible_fields": [
    "name",
    "location",
    "scope",
    "contacts",
    "matter_no",
    "practice_area"
  ],
  "features": {
    "money": false,
    "game_layer": false,
    "analytics": true
  },
  "workflows": {
    "workflows": [
      {
        "id": "matter",
        "label": "Matter",
        "icon": "⚖️",
        "color": "#f0b429",
        "stages": [
          {
            "id": "intake",
            "label": "Intake",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Conflict check and engagement letter",
              "date_type": "sla",
              "sla_hours": 8,
              "category": "intake"
            },
            "advance_on_task_complete": "engagement_sent"
          },
          {
            "id": "engagement_sent",
            "label": "Engagement Sent",
            "role": "out",
            "column": true,
            "owning_task": {
              "text": "Follow up on engagement letter",
              "date_type": "follow_up",
              "days": 5
            },
            "auto_arm": false
          },
          {
            "id": "active",
            "label": "Active",
            "role": "won",
            "column": true,
            "owning_task": {
              "text": "Review matter status",
              "date_type": "follow_up",
              "days": 10,
              "category": "matter"
            }
          },
          {
            "id": "awaiting_client",
            "label": "Awaiting Client",
            "role": "waiting",
            "column": true
          },
          {
            "id": "awaiting_court",
            "label": "Awaiting Court / Opposing",
            "role": "waiting",
            "column": true
          },
          {
            "id": "cold",
            "label": "Dormant",
            "role": "cold",
            "column": false
          },
          {
            "id": "complete",
            "label": "Closed",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "intake",
        "won_transition": {
          "from": "engagement_sent",
          "to": "active"
        },
        "extra_tasks": []
      },
      {
        "id": "general",
        "label": "General Task",
        "icon": "📋",
        "color": "#a0a0a0",
        "stages": [
          {
            "id": "action_required",
            "label": "To Do",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Respond",
              "date_type": "sla",
              "sla_hours": 4
            }
          },
          {
            "id": "waiting",
            "label": "Waiting",
            "role": "waiting",
            "column": true
          },
          {
            "id": "complete",
            "label": "Done",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "action_required",
        "won_transition": null,
        "extra_tasks": []
      }
    ],
    "tabs": [
      {
        "id": "active",
        "label": "Active",
        "filter": {
          "closed": false
        },
        "urgency": "sum"
      },
      {
        "id": "todo",
        "label": "To Do",
        "filter": {
          "stage_in": [
            "intake",
            "action_required"
          ]
        },
        "urgency": "max"
      },
      {
        "id": "deadlines",
        "label": "Deadlines",
        "filter": {
          "subtask_date_type": "deadline",
          "pending": true
        },
        "urgency": "deadline"
      },
      {
        "id": "closed",
        "label": "Closed",
        "filter": {
          "closed": true
        },
        "urgency": "none"
      },
      {
        "id": "ignored",
        "label": "Ignored",
        "filter": {
          "stage_in": [
            "ignored"
          ]
        },
        "urgency": "none"
      }
    ],
    "tab_rules": {
      "auto_stage_tabs": true
    },
    "sort": {
      "mode": "subtask",
      "priority": [
        {
          "id": "deadline",
          "label": "Deadline",
          "match": {
            "date_type": "deadline"
          }
        },
        {
          "id": "sla",
          "label": "Reply by",
          "match": {
            "date_type": "sla"
          }
        },
        {
          "id": "follow_up",
          "label": "Follow-up",
          "match": {
            "date_type": "follow_up"
          }
        },
        {
          "id": "other",
          "label": "Everything else",
          "match": {}
        }
      ]
    },
    "hud": {
      "hp": "won_vs_goal",
      "mp": "quoted_vs_goal",
      "xp": "threads_closed"
    },
    "theme": "default"
  }
}
