  "id_patterns": [
    {
      "key": "job_no",
      "label": "Job #",
      "regex": "\\b(?:Job|WO|Invoice)\\s*#?\\s*:?\\s*(\\d{3,8})\\b",
      "unique_match": true
    }
  ],
  "date_types": [
    {
      "id": "follow_up",
