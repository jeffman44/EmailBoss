{
  "id": "general",
  "label": "General",
  "description": "A plain to-do / waiting / done board for any kind of work.",
  "icon": "📋",
  "entity": {
    "project": "Project",
    "projects": "Projects",
    "client": "Client",
    "location": "Location",
    "contact": "Contact",
    "quote": "Proposal"
  },
  "work_types": [
    {
      "id": "task",
      "label": "Task",
      "short": "TASK",
      "color": "#8899aa",
      "workflow_id": "general"
    }
  ],
  "fields": [
    {
      "key": "reference_no",
      "label": "Ref #",
      "type": "text",
      "show_on": [
        "card",
        "drawer",
        "list"
      ],
      "searchable": true,
      "group": "Details",
      "source": "key_details"
    },
    {
      "key": "quote_amount",
      "label": "Quoted",
      "type": "money",
      "show_on": [
        "card",
        "drawer",
        "list"
      ],
      "searchable": false,
      "group": "Money",
      "source": "column"
    }
  ],
  "id_patterns": [
    {
      "key": "reference_no",
      "label": "Ref #",
      "regex": "\\b[A-Z]{2}-\\d{4,6}\\b",
      "unique_match": true
    }
  ],
  "date_types": [
    {
      "id": "follow_up",
      "label": "Follow-up"
    },
    {
      "id": "deadline",
      "label": "Deadline"
    },
    {
      "id": "sla",
      "label": "SLA"
    }
  ],
  "teams": [],
  "business_hours": {
    "tz": "America/New_York",
    "start": 8,
    "end": 17,
    "days": [
      0,
      1,
      2,
      3,
      4
    ]
  },
  "sla_hours": 4,
  "money": {
    "currency": "USD",
    "annual_goal": null
  },
  "triage": {
    "classifications": [
      "request",
      "client_reply",
      "approval",
      "vendor",
      "scheduling",
      "internal",
      "informational",
      "needs_reply",
      "no_reply",
      "junk"
    ],
    "notification_senders": [
      "noreply@",
      "no-reply@",
      "notifications@",
      "donotreply@",
      "mailer-daemon@"
    ],
    "internal_admin_subjects": [
      "timesheet",
      "payroll",
      "benefits enrollment",
      "open enrollment",
      "parking"
    ]
  },
  "vocab": {
    "keywords": [],
    "acronyms": [],
    "scope_phrases": []
  },
  "prompt_profile": {
    "industry": "general business",
    "role_noun": "professional"
  },
  "customer_visible_fields": [
    "name",
    "location",
    "scope",
    "contacts"
  ],
  "features": {
    "money": true,
    "game_layer": true,
    "analytics": true
  },
  "workflows": {
    "workflows": [
      {
        "id": "general",
        "label": "General Task",
        "icon": "📋",
        "color": "#a0a0a0",
        "stages": [
          {
            "id": "action_required",
            "label": "To Do",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Respond",
              "date_type": "sla",
              "sla_hours": 4
            }
          },
          {
            "id": "waiting",
            "label": "Waiting",
            "role": "waiting",
            "column": true
          },
          {
            "id": "complete",
            "label": "Done",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "action_required",
        "won_transition": null,
        "extra_tasks": []
      }
    ],
    "tabs": [
      {
        "id": "active",
        "label": "Active",
        "filter": {
          "closed": false
        },
        "urgency": "sum"
      },
      {
        "id": "todo",
        "label": "To Do",
        "filter": {
          "stage_in": [
            "action_required"
          ]
        },
        "urgency": "max"
      },
      {
        "id": "deadlines",
        "label": "Deadlines",
        "filter": {
          "subtask_date_type": "deadline",
          "pending": true
        },
        "urgency": "deadline"
      },
      {
        "id": "closed",
        "label": "Closed",
        "filter": {
          "closed": true
        },
        "urgency": "none"
      },
      {
        "id": "ignored",
        "label": "Ignored",
        "filter": {
          "stage_in": [
            "ignored"
          ]
        },
        "urgency": "none"
      }
    ],
    "tab_rules": {
      "auto_stage_tabs": true
    },
    "sort": {
      "mode": "subtask",
      "priority": [
        {
          "id": "deadline",
          "label": "Deadline",
          "match": {
            "date_type": "deadline"
          }
        },
        {
          "id": "sla",
          "label": "SLA",
          "match": {
            "date_type": "sla"
          }
        },
        {
          "id": "follow_up",
          "label": "Follow-up",
          "match": {
            "date_type": "follow_up"
          }
        },
        {
          "id": "other",
          "label": "Everything else",
          "match": {}
        }
      ]
    },
    "hud": {
      "hp": "won_vs_goal",
      "mp": "quoted_vs_goal",
      "xp": "threads_closed"
    },
    "theme": "default"
  }
}
