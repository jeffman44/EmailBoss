  "workflows": {
    "workflows": [
      {
        "id": "bid",
        "label": "Bid",
        "icon": "🏗️",
        "color": "#f0b429",
        "stages": [
          {
            "id": "takeoff",
            "label": "Takeoff",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Prepare and submit bid",
              "date_type": "quote"
            },
            "advance_on_task_complete": "submitted"
          },
          {
            "id": "submitted",
            "label": "Bid Submitted",
            "role": "out",
            "column": true,
            "owning_task": {
              "text": "Follow up on bid",
              "date_type": "follow_up",
              "days": 7
            },
            "auto_arm": false
          },
          {
            "id": "awarded",
            "label": "Awarded",
            "role": "won",
            "column": true,
            "owning_task": {
              "text": "Execute contract and set up job",
              "date_type": "sla",
              "sla_hours": 8,
              "category": "setup"
            },
            "advance_on_task_complete": "preconstruction"
          },
          {
            "id": "preconstruction",
            "label": "Preconstruction",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Confirm submittals and schedule",
              "date_type": "follow_up",
              "days": 10,
              "category": "preconstruction"
            },
            "advance_on_task_complete": "in_progress"
          },
          {
            "id": "in_progress",
            "label": "In Progress",
            "role": "in_progress",
            "column": true
          },
          {
            "id": "punch_list",
            "label": "Punch List",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Close punch list",
              "date_type": "follow_up",
              "days": 5,
              "category": "closeout"
            },
            "advance_on_task_complete": "complete"
          },
          {
            "id": "cold",
            "label": "Lost / Cold",
            "role": "cold",
            "column": false
          },
          {
            "id": "complete",
            "label": "Complete",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "takeoff",
        "won_transition": {
          "from": "submitted",
          "to": "awarded"
        },
        "extra_tasks": []
      },
      {
        "id": "change_order",
        "label": "Change Order",
        "icon": "📝",
        "color": "#c678dd",
        "stages": [
          {
            "id": "pricing",
            "label": "Pricing",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Price and send change order",
              "date_type": "quote"
            },
            "advance_on_task_complete": "sent"
          },
          {
            "id": "sent",
            "label": "Sent",
            "role": "out",
            "column": true,
            "owning_task": {
              "text": "Follow up on change order",
              "date_type": "follow_up",
              "days": 5
            },
            "auto_arm": false
          },
          {
            "id": "approved",
            "label": "Approved",
            "role": "won",
            "column": true
          },
          {
            "id": "complete",
            "label": "Closed",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "pricing",
        "won_transition": {
          "from": "sent",
          "to": "approved"
        },
        "extra_tasks": []
      },
      {
        "id": "rfi",
        "label": "RFI / Submittal",
        "icon": "❓",
        "color": "#4fc3f7",
        "stages": [
          {
            "id": "open",
            "label": "Open",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Respond to RFI",
              "date_type": "sla",
              "sla_hours": 8,
              "category": "rfi"
            }
          },
          {
            "id": "waiting",
            "label": "Waiting on Architect",
            "role": "waiting",
            "column": true
          },
          {
            "id": "complete",
            "label": "Answered",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "open",
        "won_transition": null,
        "extra_tasks": []
      },
      {
        "id": "general",
        "label": "General Task",
        "icon": "📋",
        "color": "#a0a0a0",
        "stages": [
          {
            "id": "action_required",
            "label": "To Do",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Respond",
              "date_type": "sla",
              "sla_hours": 4
            }
          },
          {
            "id": "waiting",
            "label": "Waiting",
            "role": "waiting",
            "column": true
          },
          {
            "id": "complete",
            "label": "Done",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "action_required",
        "won_transition": null,
        "extra_tasks": []
      }
    ],
    "tabs": [
      {
        "id": "active",
        "label": "Active",
        "filter": {
          "closed": false
        },
        "urgency": "sum"
      },
      {
        "id": "todo",
        "label": "To Do",
        "filter": {
          "stage_in": [
            "takeoff",
            "pricing",
            "open",
            "action_required"
          ]
        },
        "urgency": "max"
      },
      {
        "id": "deadlines",
        "label": "Deadlines",
        "filter": {
          "subtask_date_type": "deadline",
          "pending": true
        },
        "urgency": "deadline"
      },
      {
        "id": "closed",
        "label": "Closed",
        "filter": {
          "closed": true
        },
        "urgency": "none"
      },
      {
        "id": "ignored",
        "label": "Ignored",
        "filter": {
          "stage_in": [
            "ignored"
          ]
        },
        "urgency": "none"
      }
    ],
    "tab_rules": {
      "auto_stage_tabs": true
