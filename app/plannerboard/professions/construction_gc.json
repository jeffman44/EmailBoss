  "id_patterns": [
    {
      "key": "project_no",
      "label": "Project #",
      "regex": "\\b(?:Project|Job)\\s*#?\\s*:?\\s*(\\d{4,8})\\b",
      "unique_match": true
    },
    {
      "key": "rfi_number",
      "label": "RFI #",
      "regex": "\\bRFI\\s*#?\\s*:?\\s*(\\d{1,5})\\b",
      "unique_match": false
    },
    {
      "key": "co_number",
      "label": "CO #",
      "regex": "\\b(?:CO|Change\\s*Order)\\s*#?\\s*:?\\s*(\\d{1,5})\\b",
      "unique_match": false
    }
