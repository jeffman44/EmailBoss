{
  "id": "property_management",
  "label": "Property Management",
  "description": "Tenant work orders through vendor dispatch and verification, plus lease proposals and renewals.",
  "icon": "🏢",
  "entity": {
    "project": "Ticket",
    "projects": "Tickets",
    "client": "Tenant",
    "location": "Property",
    "contact": "Contact",
