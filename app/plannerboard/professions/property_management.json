      "type": "date",
      "show_on": [
        "drawer"
      ],
      "searchable": false,
      "group": "Money",
      "source": "column"
    }
  ],
  "id_patterns": [
    {
      "key": "work_order",
      "label": "WO #",
      "regex": "\\b(?:WO|Work\\s*Order|Ticket)\\s*#?\\s*:?\\s*(\\d{4,8})\\b",
      "unique_match": true
    },
    {
      "key": "unit",
      "label": "Unit",
      "regex": "\\b(?:Unit|Suite|Ste\\.?)\\s*#?\\s*([A-Z]?\\d{1,5}[A-Z]?)\\b",
      "unique_match": false
    }
  ],
  "date_types": [
    {
      "id": "follow_up",
      "label": "Follow-up"
    },
    {
      "id": "deadline",
      "label": "Deadline"
    },
    {
      "id": "sla",
      "label": "Reply by"
    },
    {
      "id": "quote",
      "label": "Quote request"
    }
  ],
  "teams": [],
  "business_hours": {
    "tz": "",
    "start": 8,
    "end": 17,
    "days": [
      0,
      1,
      2,
      3,
      4
    ]
  },
  "sla_hours": 4,
  "money": {
    "currency": "USD",
    "annual_goal": null
  },
  "triage": {
    "classifications": [
      "request",
      "client_reply",
      "approval",
      "vendor",
      "scheduling",
      "internal",
      "informational",
      "needs_reply",
      "no_reply",
      "junk",
      "maintenance_request",
      "lease_inquiry",
      "vendor_invoice",
      "tenant_complaint"
    ],
    "notification_senders": [
      "noreply@",
