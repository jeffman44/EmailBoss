    {
      "key": "quote_amount",
      "label": "Quoted",
      "type": "money",
      "show_on": [
        "card",
        "drawer",
        "list"
      ],
      "searchable": false,
      "group": "Money",
      "source": "column"
    },
    {
      "key": "approved_amount",
      "label": "Approved",
      "type": "money",
      "show_on": [
        "drawer",
        "list"
      ],
      "searchable": false,
