  "id_patterns": [
    {
      "key": "work_order",
      "label": "WO #",
      "regex": "\\b(?:WO|W\\.O\\.|Work\\s*Order)\\s*#?\\s*:?\\s*(\\d{5,8})\\b",
      "unique_match": true
    },
    {
      "key": "po_number",
      "label": "PO #",
      "regex": "\\b(?:PO|P\\.O\\.|Purchase\\s*Order)\\s*#?\\s*:?\\s*(\\d{5,8})\\b",
