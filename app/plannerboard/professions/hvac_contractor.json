  "workflows": {
    "workflows": [
      {
        "id": "quote",
        "label": "Quote Request",
        "icon": "⚡",
        "color": "#f0b429",
        "stages": [
          {
            "id": "quote_needed",
            "label": "Quote Needed",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Prepare and send proposal",
              "date_type": "quote"
            },
            "advance_on_task_complete": "quote_sent"
          },
          {
            "id": "quote_sent",
            "label": "Quote Sent",
            "role": "out",
            "column": true,
            "owning_task": {
              "text": "Follow up with customer",
              "date_type": "follow_up",
              "days": 5
            },
            "auto_arm": false
          },
          {
            "id": "job_setup",
            "label": "Needs Setup",
            "role": "won",
            "column": true,
            "owning_task": {
              "text": "Set up job",
              "date_type": "sla",
              "sla_hours": 4,
              "category": "setup"
            },
            "advance_on_task_complete": "parts_needed"
          },
          {
            "id": "parts_needed",
            "label": "Parts / PO",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Order parts",
              "date_type": "sla",
              "sla_hours": 4,
              "category": "ordering"
            },
            "advance_on_task_complete": "awaiting_parts"
          },
          {
            "id": "awaiting_parts",
            "label": "Awaiting Parts",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Confirm parts received",
              "date_type": "follow_up",
              "days": 7,
              "category": "ordering"
            },
            "advance_on_task_complete": "ready_to_schedule"
          },
          {
            "id": "ready_to_schedule",
            "label": "Ready to Schedule",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Schedule job",
              "date_type": "follow_up",
              "days": 3,
              "category": "scheduling"
            },
            "advance_on_task_complete": "scheduled"
          },
          {
            "id": "scheduled",
            "label": "Scheduled",
            "role": "in_progress",
            "column": true
          },
          {
            "id": "cold",
            "label": "Cold",
            "role": "cold",
            "column": false
          },
          {
            "id": "complete",
            "label": "Closed",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "quote_needed",
        "won_transition": {
          "from": "quote_sent",
          "to": "job_setup"
        },
        "extra_tasks": []
      },
      {
        "id": "service_call",
        "label": "Service Call",
        "icon": "🔧",
        "color": "#4fc3f7",
        "stages": [
          {
            "id": "call_in",
            "label": "Call In",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Forward to dispatch",
              "date_type": "sla",
              "sla_hours": 4,
              "category": "dispatch"
            },
            "advance_on_task_complete": "dispatched"
          },
          {
            "id": "dispatched",
            "label": "Dispatched",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Follow up with dispatch",
              "date_type": "follow_up",
              "days": 3,
              "category": "dispatch"
            }
          },
          {
            "id": "complete",
            "label": "Closed",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "call_in",
        "won_transition": null,
        "extra_tasks": []
      },
      {
        "id": "general",
        "label": "General Task",
        "icon": "📋",
        "color": "#a0a0a0",
        "stages": [
          {
            "id": "action_required",
            "label": "To Do",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Respond",
              "date_type": "sla",
              "sla_hours": 4
            }
          },
          {
            "id": "waiting",
            "label": "Waiting",
            "role": "waiting",
            "column": true
          },
          {
            "id": "complete",
            "label": "Done",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "action_required",
        "won_transition": null,
        "extra_tasks": []
      }
    ],
    "tabs": [
      {
        "id": "active",
        "label": "Active",
        "filter": {
          "closed": false
        },
        "urgency": "sum"
      },
      {
        "id": "todo",
        "label": "To Do",
        "filter": {
          "stage_in": [
            "quote_needed",
            "action_required",
            "call_in"
          ]
        },
        "urgency": "max"
      },
      {
        "id": "quotes",
        "label": "Quotes",
        "filter": {
          "stage_in": [
            "quote_needed"
          ]
        },
        "urgency": "max"
      },
      {
        "id": "deadlines",
        "label": "Deadlines",
        "filter": {
          "subtask_date_type": "deadline",
          "pending": true
        },
        "urgency": "deadline"
      },
      {
        "id": "closed",
        "label": "Closed",
        "filter": {
          "closed": true
        },
        "urgency": "none"
      },
      {
        "id": "ignored",
        "label": "Ignored",
        "filter": {
          "stage_in": [
            "ignored"
          ]
        },
        "urgency": "none"
      }
    ],
    "tab_rules": {
      "auto_stage_tabs": true
    },
    "sort": {
      "mode": "subtask",
      "priority": [
        {
          "id": "deadline",
          "label": "Deadline",
          "match": {
            "date_type": "deadline"
          }
        },
        {
          "id": "quote",
          "label": "Quote request",
          "match": {
            "date_type": "quote"
          }
        },
        {
          "id": "sla",
          "label": "SLA",
          "match": {
            "date_type": "sla"
          }
        },
        {
          "id": "follow_up",
          "label": "Follow-up",
          "match": {
            "date_type": "follow_up"
          }
        },
        {
          "id": "other",
          "label": "Everything else",
          "match": {}
        }
      ]
    },
    "hud": {
      "hp": "won_vs_goal",
      "mp": "quoted_vs_goal",
      "xp": "threads_closed"
    },
    "theme": "default"
  }
}
