      3,
      4
    ]
  },
  "sla_hours": 4,
  "money": {
    "currency": "USD",
    "annual_goal": null
  },
  "triage": {
    "classifications": [
      "request",
      "client_reply",
      "approval",
      "vendor",
      "scheduling",
      "internal",
      "informational",
      "needs_reply",
      "no_reply",
