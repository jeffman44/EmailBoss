      "type": "text",
      "show_on": [
        "drawer"
      ],
      "searchable": false,
      "group": "Details",
      "source": "key_details"
    },
    {
      "key": "salary_range",
      "label": "Range",
      "type": "text",
      "show_on": [
        "drawer"
      ],
      "searchable": false,
      "group": "Details",
