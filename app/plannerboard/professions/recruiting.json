{
  "id": "recruiting",
  "label": "Recruiting",
  "description": "Requisitions from intake through offer and acceptance, and candidates from screen to placement.",
  "icon": "🧑‍💼",
  "entity": {
    "project": "Search",
    "projects": "Searches",
    "client": "Hiring Manager",
    "location": "Department",
