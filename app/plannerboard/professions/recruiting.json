      "OTE",
      "PTO"
    ],
    "scope_phrases": [
      "contract to hire",
      "direct hire",
      "contingency fee",
      "retained search"
    ]
  },
  "prompt_profile": {
    "industry": "talent acquisition and recruiting",
    "role_noun": "recruiter"
  },
  "customer_visible_fields": [
    "name",
    "location",
    "scope",
    "contacts",
    "req_no",
    "title"
  ],
  "features": {
    "money": false,
    "game_layer": false,
    "analytics": true
  },
  "workflows": {
    "workflows": [
      {
        "id": "requisition",
        "label": "Requisition",
        "icon": "📌",
        "color": "#f0b429",
        "stages": [
          {
            "id": "intake",
            "label": "Intake",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Intake call with hiring manager",
              "date_type": "sla",
              "sla_hours": 8,
              "category": "intake"
            },
            "advance_on_task_complete": "sourcing"
          },
          {
            "id": "sourcing",
            "label": "Sourcing",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Send candidate slate",
              "date_type": "follow_up",
              "days": 5,
              "category": "sourcing"
            }
          },
          {
            "id": "interviewing",
            "label": "Interviewing",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Collect interview feedback",
              "date_type": "follow_up",
              "days": 2
            }
          },
          {
            "id": "offer_out",
            "label": "Offer Out",
            "role": "out",
            "column": true,
            "owning_task": {
              "text": "Follow up on offer",
              "date_type": "follow_up",
              "days": 2
            },
            "auto_arm": false
          },
          {
            "id": "accepted",
            "label": "Accepted",
            "role": "won",
            "column": true,
            "owning_task": {
              "text": "Start onboarding paperwork",
              "date_type": "sla",
              "sla_hours": 8,
              "category": "onboarding"
            },
            "advance_on_task_complete": "complete"
          },
          {
            "id": "on_hold",
            "label": "On Hold",
            "role": "waiting",
            "column": true
          },
          {
            "id": "cold",
            "label": "Cold",
            "role": "cold",
            "column": false
          },
          {
            "id": "complete",
            "label": "Filled",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "intake",
        "won_transition": {
          "from": "offer_out",
          "to": "accepted"
        },
        "extra_tasks": []
      },
      {
        "id": "candidate",
        "label": "Candidate",
        "icon": "🧑‍💼",
        "color": "#4fc3f7",
        "stages": [
          {
            "id": "new",
            "label": "New",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Screen candidate",
              "date_type": "sla",
              "sla_hours": 8,
              "category": "screen"
            },
            "advance_on_task_complete": "screened"
          },
          {
            "id": "screened",
            "label": "Screened",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Submit to hiring manager",
              "date_type": "follow_up",
              "days": 2
            }
          },
          {
            "id": "submitted",
            "label": "Submitted",
            "role": "out",
            "column": true
          },
          {
            "id": "placed",
            "label": "Placed",
            "role": "won",
            "column": true
          },
          {
            "id": "cold",
            "label": "Not a fit",
            "role": "cold",
            "column": false
          },
          {
            "id": "complete",
            "label": "Closed",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "new",
        "won_transition": {
          "from": "submitted",
          "to": "placed"
        },
        "extra_tasks": []
      },
      {
        "id": "general",
        "label": "General Task",
        "icon": "📋",
        "color": "#a0a0a0",
        "stages": [
          {
            "id": "action_required",
            "label": "To Do",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Respond",
              "date_type": "sla",
              "sla_hours": 4
            }
          },
          {
            "id": "waiting",
            "label": "Waiting",
            "role": "waiting",
            "column": true
          },
          {
            "id": "complete",
            "label": "Done",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "action_required",
        "won_transition": null,
        "extra_tasks": []
      }
    ],
    "tabs": [
      {
        "id": "active",
        "label": "Active",
        "filter": {
          "closed": false
        },
        "urgency": "sum"
      },
      {
        "id": "todo",
        "label": "To Do",
        "filter": {
          "stage_in": [
            "intake",
            "new",
            "action_required"
          ]
        },
        "urgency": "max"
      },
      {
        "id": "deadlines",
        "label": "Deadlines",
        "filter": {
          "subtask_date_type": "deadline",
          "pending": true
        },
        "urgency": "deadline"
      },
      {
        "id": "closed",
        "label": "Closed",
        "filter": {
          "closed": true
        },
        "urgency": "none"
      },
      {
        "id": "ignored",
        "label": "Ignored",
        "filter": {
          "stage_in": [
            "ignored"
          ]
        },
        "urgency": "none"
      }
    ],
    "tab_rules": {
      "auto_stage_tabs": true
    },
    "sort": {
      "mode": "subtask",
      "priority": [
        {
          "id": "deadline",
          "label": "Deadline",
          "match": {
            "date_type": "deadline"
          }
        },
        {
          "id": "sla",
          "label": "Reply by",
          "match": {
            "date_type": "sla"
          }
        },
        {
          "id": "follow_up",
          "label": "Follow-up",
          "match": {
            "date_type": "follow_up"
          }
        },
        {
          "id": "other",
          "label": "Everything else",
          "match": {}
        }
      ]
    },
    "hud": {
      "hp": "won_vs_goal",
      "mp": "quoted_vs_goal",
      "xp": "threads_closed"
    },
    "theme": "default"
  }
}
