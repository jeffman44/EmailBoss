    },
    {
      "key": "approved_amount",
      "label": "Fee agreed",
      "type": "money",
      "show_on": [
        "drawer",
        "list"
      ],
      "searchable": false,
      "group": "Money",
      "source": "column"
    }
  ],
  "id_patterns": [
    {
      "key": "req_no",
      "label": "Req #",
      "regex": "\\b(?:Req|Requisition|JR|Job)\\s*#?\\s*:?\\s*(\\d{3,8})\\b",
      "unique_match": true
    }
  ],
  "date_types": [
    {
      "id": "follow_up",
      "label": "Follow-up"
    },
    {
      "id": "deadline",
      "label": "Deadline"
    },
    {
      "id": "sla",
      "label": "Reply by"
    }
  ],
  "teams": [],
  "business_hours": {
    "tz": "",
