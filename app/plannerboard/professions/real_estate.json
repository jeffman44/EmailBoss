  "workflows": {
    "workflows": [
      {
        "id": "listing",
        "label": "Listing",
        "icon": "\ud83c\udfe0",
        "color": "#f0b429",
        "stages": [
          {
            "id": "lead",
            "label": "Lead",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Respond to lead",
              "date_type": "sla",
              "sla_hours": 2,
              "category": "lead"
            },
            "advance_on_task_complete": "appointment"
          },
          {
            "id": "appointment",
            "label": "Appointment Set",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Prepare listing presentation",
              "date_type": "follow_up",
              "days": 2
            },
            "advance_on_task_complete": "proposal"
          },
          {
            "id": "proposal",
            "label": "Proposal",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Send listing proposal",
              "date_type": "quote"
            },
            "advance_on_task_complete": "proposal_sent"
          },
          {
            "id": "proposal_sent",
            "label": "Proposal Sent",
            "role": "out",
            "column": true,
            "owning_task": {
              "text": "Follow up with seller",
              "date_type": "follow_up",
              "days": 3
            },
            "auto_arm": false
          },
          {
            "id": "listed",
            "label": "Listed",
            "role": "won",
            "column": true,
            "owning_task": {
              "text": "Review showings and feedback",
              "date_type": "follow_up",
              "days": 7,
              "category": "listing"
            }
          },
          {
            "id": "showing_scheduled",
            "label": "Showing scheduled",
            "role": "in_progress",
            "column": true
          },
          {
            "id": "under_contract",
            "label": "Under Contract",
            "role": "in_progress",
            "column": true,
            "owning_task": {
              "text": "Track contingencies",
              "date_type": "follow_up",
              "days": 5,
              "category": "closing"
            },
            "advance_on_task_complete": "complete"
          },
          {
            "id": "cold",
            "label": "Cold",
            "role": "cold",
            "column": false
          },
          {
            "id": "complete",
            "label": "Closed",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
        ],
        "entry_stage": "lead",
        "won_transition": {
          "from": "proposal_sent",
          "to": "listed"
        },
        "extra_tasks": []
      },
      {
        "id": "buyer",
