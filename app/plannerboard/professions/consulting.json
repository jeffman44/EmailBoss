  "id_patterns": [
    {
      "key": "sow_no",
      "label": "SOW #",
      "regex": "\\b(?:SOW|Statement\\s*of\\s*Work)\\s*#?\\s*:?\\s*([A-Z0-9-]{3,12})\\b",
      "unique_match": true
    }
  ],
  "date_types": [
    {
