    },
    {
      "id": "sla",
      "label": "SLA"
    },
    {
      "id": "quote",
      "label": "Quote request"
    }
  ],
  "teams": [],
  "business_hours": {
    "tz": "America/New_York",
    "start": 8,
    "end": 17,
    "days": [
      0,
      1,
      2,
      3,
      4
    ]
  },
  "sla_hours": 4,
  "money": {
    "currency": "USD",
    "annual_goal": null
  },
  "triage": {
    "classifications": [
      "request",
      "client_reply",
      "approval",
      "vendor",
      "scheduling",
      "internal",
      "informational",
      "needs_reply",
