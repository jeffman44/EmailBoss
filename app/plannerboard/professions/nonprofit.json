        "stages": [
          {
            "id": "respond",
            "label": "Respond",
            "role": "todo",
            "column": true,
            "owning_task": {
              "text": "Reply to the request",
              "date_type": "sla",
              "sla_hours": 8
            }
          },
          {
            "id": "waiting",
            "label": "Waiting",
            "role": "waiting",
            "column": true
          },
          {
            "id": "done",
            "label": "Done",
            "role": "closed",
            "column": false,
            "closed": true
          },
          {
            "id": "ignored",
            "label": "Ignored",
            "role": "ignored",
            "column": false,
            "closed": true
          }
